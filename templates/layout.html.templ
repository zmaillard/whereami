package templates

import (
    "fmt"
    "github.com/zmaillard/whereami/templates/components"
)

templ Page (title string, version string) {
<!DOCTYPE html>
<html lang="en" class="">
<head>
    <meta charset="UTF-8">
    <meta content="width=device-width,initial-scale=1" name="viewport">
    <meta name="theme-color" content="#1f6821">
    <title>{ title }</title>

    <link href="/assets/css/app.css" rel="stylesheet" type="text/css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css"
    >
    @components.Css()

    @components.Script()
</head>
<body hx-ext="loading-states">
        { children... }
          <footer class="footer">
            <div class="content has-text-centered">
              <p>
                <strong>Where Am I?</strong> by <a href="https://zachmaillard.xyz">Zach Maillard</a> <br/>
                <a href="/">Text Search</a> | <a href="/map">Map Search</a> | <a href="/about">About</a>  <br/>
                <a href={templ.URL(fmt.Sprintf("https://github.com/zmaillard/whereami/releases/tag/%s", version))}>{version}</a>
              </p>
            </div>
          </footer>


    <script src="/assets/js/theme.js"></script>
</body>
</html>
}