package templates

import (

    "github.com/zmaillard/whereami/templates/components"
)

templ Results(content components.InitialResultDto) {
    @Page("Where Am I?", content.BaseUrl, content.VersionNumber) {
          <article x-data="result" class="prose p-4">
            <h2>Location</h2>
            <p>
                <strong>Latitude:</strong> <span id="latitude">{content.Latitude}</span>
                <br/>
                <strong>Longitude:</strong> <span id="longitude">{content.Longitude}</span>
            </p>
            <h2>Political Boundaries</h2>
            <p>
                <strong>County:</strong> {content.County}
                <br/>
                <strong>State:</strong> {content.State}
            </p>
            <template x-if="ready">
                <div>
                    <h2>Meteorology</h2>
                    <strong>Weather Service Office:</strong> <a :href="formattedOfficeLink" x-text="weather_service_office"></a>
                    <br/>
                    <div class="flex">
                        <strong>Sunrise:</strong>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="p-2 size-6">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
                        </svg>
                        <span x-text="sunrise"></span>
                    </div>
                    <div class="flex">
                        <strong>Sunset:</strong>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="p-2 size-6">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
                        </svg>
                        <span x-text="sunset"></span>
                    </div>
                    <h2>Topography</h2>
                    <strong>Elevation:</strong> <span x-text="formattedElevation"></span>
                    <br/>
                    <strong>Nearest Summit:</strong> <span x-text="formattedSummit"></span>
                    <h2>Hydrography</h2>
                    <strong>Drains Into: </strong> <span x-text="sink"></span>
                    <br />
                    <strong>All Tributaries: </strong> <span x-text="formattedTributaries"></span>
                </div>
            </template>
          </article>
          <script src="/assets/result.js"></script>
    }
}
