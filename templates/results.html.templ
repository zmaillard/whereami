package templates

import (
    "time"

    "github.com/zmaillard/whereami/templates/components"
)

templ Results(content components.ResultDto) {
    <div>
        <h3>Location</h3>
        <strong>Latitude:</strong> {content.GetLatitude()}
        <br>
        <strong>Longitude:</strong> {content.GetLongitude()}
        <h3>Political Boundaries</h3>
        <strong>County:</strong> {content.County}
        <br>
        <strong>State:</strong> {content.State}
        <h3>Meteorology</h3>
        <strong>Weather Service Office: </strong> <a href={content.GetFormattedOfficeLink()}>{content.WeatherServiceOfficeName}</a>
        <br>
        <strong>Sunrise:</strong> {content.Sunrise.Format(time.Kitchen)}
        <br>
        <strong>Sunset:</strong> {content.Sunset.Format(time.Kitchen)}
        <h3>Topography</h3>
        <strong>Elevation:</strong> {content.GetFormattedElevation()}
        <br>
        <strong>Nearest Summit:</strong> {content.GetFormattedSummit()}
        <h3>Hydrography</h3>
        <strong>Drains Into: </strong> {content.GetSink()}
        <br>
        <strong>All Tributaries: </strong> {content.GetFormattedTributaries()}
    </div>
}
