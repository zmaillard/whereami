package components

templ Footer(version string) {
    <footer class="bg-alpine-800 dark:bg-alpine-950 text-stone-300 dark:text-stone-400 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between text-sm">
            <span class="font-semibold tracking-wide text-alpine-300 dark:text-alpine-400">Highpoints</span>
            <span class="text-stone-400 dark:text-stone-500">v{ version }</span>
        </div>
    </footer>
}
